# Google Cloud Environment Configuration (ADC Enforced - Zero Hardcoded Keys)
GOOGLE_CLOUD_PROJECT=h3-healthcare-prod
GOOGLE_CLOUD_LOCATION=us-west2
GOOGLE_GENAI_USE_ENTERPRISE=true

# Fail-Closed Guardrails
SYNTHETIC_ONLY=true
LOCAL_STORAGE_MOCK=false
USE_LIVE_DLP=true

# Storage Buckets
CMEK_INTAKE_BUCKET=gs://h3-claim-raw-intake
MODE_A_VAULT_BUCKET=gs://h3-vault-consulting
MODE_B_VAULT_BUCKET=gs://h3-vault-litigation
